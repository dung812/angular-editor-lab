{
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // VS Code defaults these to true for files it treats as outside a tsconfig
  // project, which re-introduces strict errors even though tsconfig.json has
  // strict disabled. Turn them off so the editor matches the build.
  "js/ts.implicitProjectConfig.strictNullChecks": false,
  "js/ts.implicitProjectConfig.strictFunctionTypes": false,
  "js/ts.implicitProjectConfig.checkJs": false
}
